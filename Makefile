.PHONY: build test vet race fmt

build:
	go build -o fleck ./cmd/fleck

test:
	go test ./...
	cd examples/payment-service && go test ./...
	cd examples/monolith && go test ./...
	cd examples/microservices-monorepo && go test ./...
	cd examples/polyrepo/application-repo && go test ./...

vet:
	go vet ./...
	cd examples/payment-service && go vet ./...
	cd examples/monolith && go vet ./...
	cd examples/microservices-monorepo && go vet ./...
	cd examples/polyrepo/application-repo && go vet ./...

race:
	go test -race ./...

fmt:
	gofmt -w cmd internal examples/payment-service/cmd examples/monolith/cmd examples/monolith/internal examples/microservices-monorepo/services examples/microservices-monorepo/shared examples/polyrepo/application-repo/cmd evaluation/fixtures/go
